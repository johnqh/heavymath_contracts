{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/unified",
    "noEmit": false,
    "jsx": "react"
  },
  "include": [
    "src/unified/**/*",
    "src/utils/**/*",
    "src/evm/**/*",
    "src/solana/**/*",
    "src/react/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/**/*",
    "target/types/**/*"
  ]
}
