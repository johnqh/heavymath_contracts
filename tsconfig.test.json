{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["./src/**/*", "./test/**/*", "./typechain-types/**/*"],
  "exclude": ["node_modules", "dist"]
}
